FROM mcr.microsoft.com/playwright

WORKDIR /app
COPY ./package.json ./package-lock.json ./

RUN npm install && npm cache clean --force

COPY . ./

# ARG DATABASE_CONNECTION_URI
# ARG GOOGLE_TRENDS_BASE_URL
# ARG TWITTER_TRENDS_URL
# ARG SPOTIFY_TRENDS_STARTING_URL
# ARG SPOTIFY_USER_EMAIL
# ARG SPOTIFY_USER_PASSWORD
# ARG SPOTIFY_TOP_PODCASTS_URL
# ARG YOUTUBE_TRENDS_URL
# ARG PORTAL_EL_DESTAPE_URL
# ARG PORTAL_TELAM_URL
# ARG PORTAL_INFOBAE_URL
# ARG PORTAL_CLARIN_URL
# ARG PORTAL_LA_NACION_URL

CMD ["npm", "run", "start"]